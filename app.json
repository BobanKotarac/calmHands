{
  "expo": {
    "name": "calmhands",
    "slug": "calmhands",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./src/assets/app-icon.png",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "splash": {
      "image": "./src/assets/app-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#0B0F10"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.bobypoz.calmhands",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./src/assets/app-icon.png",
        "backgroundColor": "#0B0F10"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "package": "com.bobypoz.calmhands"
    },
    "web": {
      "favicon": "./src/assets/app-icon.png"
    },
    "plugins": [
      "@react-native-community/datetimepicker",
      "expo-secure-store",
      "expo-font",
      "expo-localization",
      "expo-sharing",
      "expo-splash-screen",
      "expo-status-bar",
      "expo-audio",
      "expo-asset"
    ],
    "extra": {
      "eas": {
        "projectId": "c7928aa6-301a-4a91-8bc8-1a0145581ece"
      },
      "revenueCat": {
        "iosApiKey": "",
        "androidApiKey": "",
        "entitlementId": "pro"
      }
    }
  }
}
